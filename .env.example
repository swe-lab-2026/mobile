# Backend API URL. It must be an absolute URL and should include /api/v1
# (the app appends /api/v1 automatically if it is missing).
#
# There is no built-in fallback: the app shows a configuration error screen
# when this is missing or invalid.
#
# Demo / release builds: HTTPS is REQUIRED. Both iOS and Android demo builds
# must point at the same deployed API.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
#
# Development builds only (`expo start`): plain HTTP is allowed for local/LAN hosts.
#
# Android emulator (host machine loopback):
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
#
# iOS simulator:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
#
# Physical device on the same Wi-Fi (use your computer's LAN IP, not localhost):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8000/api/v1
