# Backend API URL. It must be an absolute http(s) URL and include /api/v1.
# The app appends /api/v1 automatically if it is missing, but keeping it explicit
# makes the configuration easier to verify.
#
# Android emulator (host machine loopback):
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
#
# iOS simulator:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
#
# Physical device (use your computer's LAN IP, not localhost):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8000/api/v1
#
# Deployed environment (prefer HTTPS):
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
